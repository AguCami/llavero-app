{
  "name": "llavero-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editor web para convertir imágenes vectoriales (SVG) en llaveros listos para imprimir en 3D",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:single": "vite build --config vite.config.single.ts && node scripts/build-single.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
